{
  "agents": {
    "ResearchAgent": {
      "name": "Research Assistant Agent",
      "description": "Performs external research, web searches, and document reading.",
      "role": "researcher",
      "permissions": {
        "WebSearch": {
          "actions": {
            "query": "ALLOW",
            "scrape": "ALLOW"
          }
        },
        "FileRead": {
          "actions": {
            "read": "ALLOW",
            "list": "ALLOW",
            "write": "BLOCK",
            "delete": "BLOCK"
          }
        },
        "Database": {
          "default": "BLOCK"
        },
        "Shell": {
          "default": "BLOCK"
        },
        "RefundAPI": {
          "default": "BLOCK"
        }
      }
    },
    "CustomerSupportAgent": {
      "name": "Customer Support Agent",
      "description": "Handles user inquiries, tickets, profile lookups, and refund initiation.",
      "role": "support",
      "permissions": {
        "TicketDB": {
          "actions": {
            "read": "ALLOW",
            "create": "ALLOW",
            "update": "ALLOW",
            "delete": "BLOCK"
          }
        },
        "UserProfile": {
          "actions": {
            "read": "ALLOW",
            "update": "ALLOW"
          }
        },
        "RefundAPI": {
          "actions": {
            "issue": "REVIEW",
            "query": "ALLOW"
          }
        },
        "EmailNotification": {
          "actions": {
            "send": "ALLOW"
          }
        },
        "Database": {
          "actions": {
            "drop": "BLOCK",
            "truncate": "BLOCK",
            "delete": "BLOCK"
          },
          "default": "BLOCK"
        },
        "Shell": {
          "default": "BLOCK"
        }
      }
    },
    "CodeReviewAgent": {
      "name": "Code Review & Quality Agent",
      "description": "Inspects git repositories, runs static linters, and suggests code improvements.",
      "role": "developer",
      "permissions": {
        "RepoAPI": {
          "actions": {
            "read": "ALLOW",
            "comment": "ALLOW",
            "create_pr": "REVIEW",
            "merge": "BLOCK"
          }
        },
        "LinterTool": {
          "actions": {
            "run": "ALLOW"
          }
        },
        "Shell": {
          "actions": {
            "exec": "REVIEW"
          },
          "default": "REVIEW"
        },
        "DeploymentAPI": {
          "default": "BLOCK"
        }
      }
    },
    "DataSyncAgent": {
      "name": "Data Sync & Pipeline Agent",
      "description": "Syncs datasets between databases and storage backends.",
      "role": "data_engineer",
      "permissions": {
        "Database": {
          "actions": {
            "read": "ALLOW",
            "write": "ALLOW",
            "insert": "ALLOW",
            "update": "ALLOW",
            "drop": "BLOCK",
            "truncate": "BLOCK"
          },
          "default": "REVIEW"
        },
        "S3Storage": {
          "actions": {
            "upload": "ALLOW",
            "download": "ALLOW",
            "delete": "REVIEW"
          }
        },
        "Webhook": {
          "actions": {
            "send": "REVIEW"
          }
        },
        "Shell": {
          "default": "BLOCK"
        }
      }
    },
    "AdminAgent": {
      "name": "System Administrator Agent",
      "description": "Elevated administrator agent with access to privileged operational tools.",
      "role": "admin",
      "permissions": {
        "Database": {
          "actions": {
            "read": "ALLOW",
            "write": "ALLOW",
            "drop": "REVIEW",
            "truncate": "REVIEW"
          },
          "default": "ALLOW"
        },
        "Shell": {
          "actions": {
            "exec": "REVIEW"
          },
          "default": "REVIEW"
        },
        "DeploymentAPI": {
          "actions": {
            "deploy": "ALLOW",
            "rollback": "ALLOW"
          }
        },
        "RefundAPI": {
          "actions": {
            "issue": "ALLOW"
          }
        }
      }
    }
  },
  "tools": {
    "WebSearch": {
      "name": "Web Search Tool",
      "description": "Queries external search engines and crawls public pages.",
      "actions": ["query", "scrape"]
    },
    "FileRead": {
      "name": "File System Reader",
      "description": "Reads local and shared workspace documents.",
      "actions": ["read", "list", "write", "delete"]
    },
    "Database": {
      "name": "Enterprise Relational Database",
      "description": "Executes SQL operations against transactional stores.",
      "actions": ["read", "write", "insert", "update", "delete", "drop", "truncate"]
    },
    "TicketDB": {
      "name": "Customer Support Ticket Database",
      "description": "Queries and updates support tickets.",
      "actions": ["read", "create", "update", "delete"]
    },
    "UserProfile": {
      "name": "User Account Profile Service",
      "description": "Manages user personal account details.",
      "actions": ["read", "update"]
    },
    "RefundAPI": {
      "name": "Payment & Refund API",
      "description": "Processes payment returns and ledger adjustments.",
      "actions": ["issue", "query"]
    },
    "EmailNotification": {
      "name": "Email Dispatch Gateway",
      "description": "Sends transactional emails to customers.",
      "actions": ["send"]
    },
    "RepoAPI": {
      "name": "Source Code Repository API",
      "description": "Interacts with GitHub/GitLab repositories.",
      "actions": ["read", "comment", "create_pr", "merge"]
    },
    "LinterTool": {
      "name": "Static Analysis Linter",
      "description": "Runs code linting and formatting analyzers.",
      "actions": ["run"]
    },
    "Shell": {
      "name": "System Command Shell Execution",
      "description": "Runs low-level operating system CLI processes.",
      "actions": ["exec"]
    },
    "DeploymentAPI": {
      "name": "Production Cloud Deployment API",
      "description": "Triggers cloud service deployment or rollback.",
      "actions": ["deploy", "rollback"]
    },
    "S3Storage": {
      "name": "Cloud Object Store (S3)",
      "description": "Manages blob files and storage buckets.",
      "actions": ["upload", "download", "delete"]
    },
    "Webhook": {
      "name": "Outbound HTTP Webhook",
      "description": "Dispatches external HTTP POST payloads.",
      "actions": ["send"]
    }
  }
}
